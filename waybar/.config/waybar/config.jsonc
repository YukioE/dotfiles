{
    "layer": "top",
    "position": "top",
    "height": 0,
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/icon",
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock",
        "power-profiles-daemon"
    ],
    "modules-right": [
        "group/tray-drawer",
        "battery",
        "bluetooth",
        "network",
        "pulseaudio",
        "sway/language",
        "custom/power"
    ],
    "custom/icon": {
        "format": "󰣇",
        "on-click": "rofi -show drun -theme ~/.config/rofi/style.rasi"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "on-click": "activate",
        "format": "{index}",
    },
    "clock": {
        "format": "{:%H:%M - %A %d.%m.%Y}",
        "interval": 1,
        "rotate": 0,
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 4,
            "first-day-of-week": 1,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<b>{}</b>",
                "weekdays": "{}",
                "today": "<span background=\"#d4d4d4\" foreground=\"#282828\"><b>{}</b></span>",
                "days": "{}"
            }
        }
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
          "transition-duration": 50,
        },
        "modules": [
          "custom/expand",
          "tray"
        ]
    },
    "custom/expand": {
        "format": "❮",
        "tooltip": false
    },
    "tray": {
        "spacing": 0,
    },
    "pulseaudio": {
        "format": "vol {volume}%",
        "tooltip": false,
        "format-muted": "vol muted",
        "on-click": "ghostty -e wiremix",
        "on-click-right": "~/.config/waybar/audio.sh",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                "",
                ""
            ]
        }
    },
    "bluetooth": {
        "format": "bt",
        "format-disabled": "",
        "format-connected": "bt {device_alias} connected",
        "format-no-controller": "",
        "on-click": "ghostty -e bluetuith",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "full-at": 80,
        "interval": 5,
        "format": "bat {capacity}%",
        // "format-charging": "BAT {capacity}%",
        // "format-plugged": "BAT {capacity}%",
        "format-alt": "{time} {icon}",
        "tooltip": true,
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "format-icons": [
            "󰂃",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "network": {
        "tooltip": true,
        "format-wifi": "wifi {essid}",
        "format-ethernet": "eth",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "format-linked": "eth {ifname} (no ip)",
        "format-disconnected": "wifi disconnected",
        "tooltip-format-disconnected": "disconnected",
        "on-click": "ghostty -e wifitui",
        "interval": 2
    },
    "sway/language": {
        "format": "{shortDescription}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/powermenu.sh"
    }
}
