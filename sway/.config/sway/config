
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term ghostty
set $menu rofi -show drun -theme ~/.config/rofi/style.rasi
set $filem dolphin

set $background #282828
set $foreground #d4d4d4
set $accent #fe640b

output "Ancor Communications Inc ASUS PB277 0x0000F421" mode 2560x1440 pos 0 870 allow_tearing yes
output "Ancor Communications Inc ASUS PB277 0x0003C51C" mode 2560x1440 pos 2560 0 transform 270 allow_tearing yes

output * bg #282828 solid_color

font JetBrainsMono Nerd Font 11

default_border pixel 2
smart_borders no_gaps
smart_gaps on
gaps inner 5

client.focused $foreground $background $foreground $accent $foreground

exec discord
exec spotify
exec firefox
exec obsidian

exec syncthing --no-browser
exec cliphist wipe
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

exec swayidle -w \
         timeout 300 'pidof hyprlock || hyprlock' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'pidof hyprlock || hyprlock'

input type:touchpad {
	dwt enabled
	tap enabled
	natural_scroll enabled
	middle_emulation enabled
}

input type:keyboard {
	xkb_layout "us,de"
	xkb_options "caps:escape"
}

input type:pointer {
	accel_profile flat
	pointer_accel -0.5
}

focus_follows_mouse always
mouse_warping container
workspace_auto_back_and_forth yes

bindsym $mod+Shift+c reload

bindsym $mod+q kill

bindsym $mod+Return exec $term
bindsym $mod+r exec $menu
bindsym $mod+e exec $filem

floating_modifier $mod normal

bindsym $mod+Shift+q exec ~/.config/waybar/powermenu.sh
bindsym $mod+Shift+v exec cliphist list | rofi -dmenu -p "" -theme ~/.config/rofi/style-clipboard.rasi | cliphist decode | wl-copy

bindsym $mod+Shift+s exec ~/.config/sway/screenshot.sh

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1; workspace 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace 10

bindsym $mod+b splith
bindsym $mod+v splitv

bindsym $mod+w layout toggle split tabbed
bindsym $mod+x move workspace to output right

bindsym $mod+f fullscreen

bindsym $mod+t floating toggle

bindsym $mod+space focus mode_toggle

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+shift+r mode "resize"

bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

bar {
    swaybar_command waybar
}

for_window [app_id="org.keepassxc.KeePassXC"] floating enable, resize set width 40ppt, resize set height 50ppt, move position center
for_window [app_id="com.mitchellh.ghostty" title="wiremix"] floating enable, resize set width 30ppt, resize set height 30ppt, move position 70ppt 0ppt
for_window [app_id="com.mitchellh.ghostty" title="wifitui"] floating enable, resize set width 30ppt, resize set height 30ppt, move position 70ppt 0ppt
for_window [app_id="com.mitchellh.ghostty" title="bluetuith"] floating enable, resize set width 30ppt, resize set height 30ppt, move position 70ppt 0ppt

assign [app_id="spotify"] workspace 2
assign [app_id="discord"] workspace 2
assign [app_id="obsidian"] workspace 3
assign [app_id="firefox"] workspace 3

include /etc/sway/config.d/*
