font-family=JetBrainsMono Nerd Font
font-size=12

background=282828
foreground=d4d4d4

window-padding-x=20
window-padding-y=15

env=EDITOR=nvim

mouse-hide-while-typing=true
cursor-style=block
shell-integration-features=no-cursor
cursor-style-blink=false
window-inherit-working-directory=false
working-directory=home
confirm-close-surface=false

custom-shader=~/.config/ghostty/cursor.glsl

palette = 0=#3c3c3c
palette = 1=#e78284
palette = 2=#a6d189
palette = 3=#e5c890
palette = 4=#8caaee
palette = 5=#ca9ee6
palette = 6=#ef9f76
palette = 7=#d4d4d4
palette = 8=#767676
palette = 9=#ffffff
palette = 10=#ffffff
palette = 11=#ffffff
palette = 12=#ffffff
palette = 13=#ffffff
palette = 14=#ffffff
palette = 15=#ffffff
